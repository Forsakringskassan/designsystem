{
    "extends": "../cypress/tsconfig.json",
    "compilerOptions": {
        "composite": true,
        "rootDir": ".",
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "lib": ["es2024", "dom", "dom.iterable"]
    },
    "include": [
        "**/*.cy.ts",
        "**/*.vue",
        "components/pagination/examples/pagination-data.ts",
        "components/table-and-list/examples/legacy/table-data.ts"
    ],
    "exclude": ["dist/**", "node_modules/**", "playground/**"]
}
