{
  "name": "@fkui/vue-labs",
  "version": "6.59.0",
  "description": "Experimental and unstable FKUI components",
  "keywords": [
    "fkui",
    "designsystem",
    "vue"
  ],
  "homepage": "https://designsystem.forsakringskassan.se/",
  "bugs": "https://github.com/Forsakringskassan/designsystem/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Forsakringskassan/designsystem.git",
    "directory": "packages/vue-labs"
  },
  "license": "MIT",
  "author": "Försäkringskassan",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.esm.js",
      "require": "./dist/cjs/index.cjs.js"
    },
    "./cypress": {
      "types": "./dist/types/cypress.d.ts",
      "import": "./dist/esm/cypress.esm.js",
      "require": "./dist/cjs/cypress.cjs.js"
    },
    "./style.css": "./dist/esm/style.css",
    "./htmlvalidate": "./htmlvalidate/index.mjs"
  },
  "main": "./dist/cjs/index.cjs.js",
  "module": "./dist/esm/index.esm.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "dummy.css",
    "htmlvalidate",
    "!**/examples/**",
    "!**/*.spec.{js,ts,d.ts,d.ts.map}"
  ],
  "scripts": {
    "build": "run-s build:lib build:dts build:api",
    "build:api": "fk-api-extractor api-extractor.*.json",
    "build:dts": "vue-tsc -b",
    "build:lib": "fk-build-vue-lib --clean --pageobjects",
    "clean": "rimraf -g dist temp",
    "prepack": "release-prepack --bundle --retain-scripts",
    "postpack": "release-postpack",
    "prepublishOnly": "release-prepublish --bundle --retain-scripts",
    "start": "vite --"
  },
  "dependencies": {
    "@vueuse/core": "15.0.0"
  },
  "devDependencies": {
    "@fkui/date": "6.59.0",
    "@fkui/design": "6.59.0",
    "@fkui/icon-lib-default": "6.59.0",
    "@fkui/logic": "6.59.0",
    "@fkui/test-utils": "6.59.0",
    "@fkui/theme-default": "6.59.0",
    "@fkui/vue": "6.59.0",
    "@forsakringskassan/docs-generator": "3.12.0",
    "@forsakringskassan/vite-lib-config": "5.12.4",
    "@forsakringskassan/vitest-config-jsdom": "5.0.0",
    "@vue/test-utils": "2.5.1",
    "esbuild": "0.28.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "peerDependencies": {
    "@fkui/date": "^6.59.0",
    "@fkui/design": "^6.59.0",
    "@fkui/logic": "^6.59.0",
    "@fkui/vue": "^6.59.0",
    "html-validate": ">= 10.10.0",
    "vue": "^3.5.34"
  },
  "peerDependenciesMeta": {
    "html-validate": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.16 || >= 24",
    "npm": ">= 7"
  }
}
