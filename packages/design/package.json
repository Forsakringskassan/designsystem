{
  "name": "@fkui/design",
  "version": "6.65.1",
  "description": "fkui design",
  "keywords": [
    "fkui",
    "designsystem",
    "css"
  ],
  "homepage": "https://designsystem.forsakringskassan.se/",
  "bugs": "https://github.com/Forsakringskassan/designsystem/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Forsakringskassan/designsystem.git",
    "directory": "packages/design"
  },
  "license": "MIT",
  "author": "Försäkringskassan",
  "sideEffects": [
    "./lib/**/*.css",
    "./src/**/*.scss"
  ],
  "exports": {
    ".": {
      "types": "./type-stub.d.ts",
      "sass": "./src/fkui.scss",
      "default": "./lib/fkui.css"
    },
    "./lib/*": "./lib/*",
    "./src/*": "./src/*",
    "./stylelint/recommended": "./stylelint/recommended.js"
  },
  "main": "./lib/fkui.css",
  "types": "type-stub.d.ts",
  "files": [
    "lib",
    "src",
    "stylelint",
    "type-stub.d.ts",
    "!**/*.spec.js"
  ],
  "scripts": {
    "build": "node build.mjs",
    "clean": "rimraf coverage lib temp test-results",
    "pretest": "node pretest.mjs",
    "test": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=test-results/jest-junit.xml",
    "posttest": "sass -p node --no-source-map tests:temp/tests",
    "unit": "node --test"
  },
  "devDependencies": {
    "@fkui/icon-lib-default": "6.65.1",
    "@fkui/theme-default": "6.65.0",
    "autoprefixer": "10.7.0",
    "cssnano": "9.9.0",
    "postcss": "8.5.33",
    "postcss-var-func-fallback": "3.0.1"
  },
  "peerDependencies": {
    "@fkui/theme-default": "^6.65.0",
    "sass": "^1.92.0",
    "stylelint": "^16.0.0 || ^17.0.0 || ^18.0.0"
  },
  "peerDependenciesMeta": {
    "sass": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.16 || >= 24",
    "npm": ">= 7"
  },
  "sass": "./src/fkui.scss"
}
