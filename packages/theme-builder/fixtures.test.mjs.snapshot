exports[`should build simple theme 1`] = `
/
├─ out/
│  ├─ index.css
│  ├─ metadata.d.mts
│  └─ metadata.mjs
└─ src/
   ├─ _version.scss
   └─ index.scss
`;

exports[`should build simple theme 2`] = `
:root {
  --x-foobar: #f0a;
}
`;

exports[`should build simple theme 3`] = `
export default {
  "themes": [
    "light",
    "dark"
  ],
  "palette": [],
  "tokens": []
}
`;

exports[`should build simple theme 4`] = `

export interface PaletteColor {
    readonly name: string;
    readonly value: string;
    readonly group: string;
}

export interface TokenValue {
    readonly value: string | null;
    readonly palette: string | null;
}

export interface Token {
    readonly name: string;
    readonly comment: string | null;
    readonly values: Record<string, TokenValue>;
}

export interface Metadata {
    readonly themes: string[];
    readonly tokens: Token[];
    readonly palette: PaletteColor[];
}

declare const metadata: Metadata;
export default metadata;

`;

exports[`should generate version 1`] = `
/
├─ out/
│  ├─ index.css
│  ├─ metadata.d.mts
│  └─ metadata.mjs
└─ src/
   ├─ _version.scss
   └─ index.scss
`;

exports[`should generate version 2`] = `
:root {
  --x-foobar: #f0a;
  --version: "1.2.3";
}
`;

exports[`should include palette 1`] = `
/
├─ out/
│  ├─ index.css
│  ├─ metadata.d.mts
│  └─ metadata.mjs
└─ src/
   ├─ _version.scss
   ├─ index.scss
   └─ palette-variables.scss
`;
